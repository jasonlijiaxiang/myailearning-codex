{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chinese-only delivery deferment registry",
  "description": "Tracks exact Chinese object deltas while preserving immutable English and bilingual-review baselines.",
  "type": "object",
  "required": ["schemaVersion", "frozenAt", "baselineCommit", "receipts", "moduleBaselines", "runtimeMaintenances", "deferments"],
  "properties": {
    "schemaVersion": { "const": "localization-deferment/v3" },
    "frozenAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "baselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["receiptId", "kind", "recordedAt", "decisionId", "summary"],
        "properties": {
          "receiptId": { "type": "string", "pattern": "^receipt-[a-z0-9-]+$" },
        "kind": { "enum": ["baseline-freeze", "locale-gate", "closure", "runtime-maintenance"] },
          "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "decisionId": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "moduleBaselines": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["zhBaselineCommit", "enBaselineCommit", "reviewSetIds", "zhReviewHash", "zhStateHash", "zhObjects", "zhRendererFiles", "enAuthoredHash", "enEffectiveHash", "enReviewHash", "enRendererFiles", "englishUpdatedAt", "reviewFiles"],
        "properties": {
          "zhBaselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "enBaselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "reviewSetIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "zhReviewHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "zhStateHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "zhObjects": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["hash", "objectType", "sourceIds"],
              "properties": {
                "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "objectType": { "type": "string", "minLength": 1 },
                "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
              },
              "additionalProperties": false
            }
          },
          "zhRendererFiles": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^app/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[A-Za-z0-9_.@()\\[\\]-]+(?:/[A-Za-z0-9_.@()\\[\\]-]+)*\\.(?:tsx?|jsx?|mjs)$" }, "uniqueItems": true },
          "enAuthoredHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "enEffectiveHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "enReviewHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "enRendererFiles": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^app/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[A-Za-z0-9_.@()\\[\\]-]+(?:/[A-Za-z0-9_.@()\\[\\]-]+)*\\.(?:tsx?|jsx?|mjs)$" }, "uniqueItems": true },
          "englishUpdatedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "reviewFiles": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["path", "hash", "zhContentHash", "enContentHash"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "zhContentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "enContentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "runtimeMaintenances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["maintenanceId", "status", "kind", "decisionId", "recordedAt", "baseCommit", "implementationCommit", "receiptId", "changedRendererFiles", "affectedModuleSlugs", "contentProjectionChangeSlugs", "metadataScope", "summary"],
        "properties": {
          "maintenanceId": { "type": "string", "pattern": "^erm-[a-z0-9-]+$" },
          "status": { "const": "applied" },
          "kind": { "enum": ["english-renderer", "document-shell"] },
          "decisionId": { "type": "string", "minLength": 1 },
          "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "implementationCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "receiptId": { "type": "string", "pattern": "^receipt-[a-z0-9-]+$" },
          "changedRendererFiles": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(?:app/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[A-Za-z0-9_.@()\\[\\]-]+(?:/[A-Za-z0-9_.@()\\[\\]-]+)*\\.(?:tsx?|jsx?|mjs)|scripts/lib/localization-contract\\.mjs)$" }, "uniqueItems": true },
          "affectedModuleSlugs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "contentProjectionChangeSlugs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "metadataScope": { "enum": ["none", "rag", "shared-module-routes", "all-en-routes"] },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "deferments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "defermentId", "moduleSlug", "sourceLocale", "targetLocale", "status",
          "openedAt", "openedFromCommit", "decisionId", "reason", "localeRequirements",
          "candidateIds", "workItemIds", "affectedObjects", "baselineReviewIds",
          "localeGateReceipt", "closureCriteria"
        ],
        "properties": {
          "defermentId": { "type": "string", "pattern": "^dfr-[a-z0-9-]+$" },
          "moduleSlug": { "type": "string", "minLength": 1 },
          "sourceLocale": { "const": "zh-CN" },
          "targetLocale": { "const": "en" },
          "status": { "enum": ["deferred", "ready-for-english-review", "closed"] },
          "openedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "openedFromCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "decisionId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "localeRequirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["date-decoupling", "semantic-deferment", "structural-deferment", "shared-runtime-decoupling"] }
          },
          "candidateIds": { "type": "array", "items": { "type": "string", "pattern": "^C-[A-Z0-9-]+$" }, "uniqueItems": true },
          "workItemIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "affectedObjects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["objectId", "objectType", "changeKind", "baselineHash", "currentHash", "sourceIds"],
              "properties": {
                "objectId": { "type": "string", "minLength": 1 },
                "objectType": { "type": "string", "minLength": 1 },
                "changeKind": { "enum": ["added", "modified", "deleted"] },
                "baselineHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
                "currentHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
                "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
              },
              "additionalProperties": false
            }
          },
          "baselineReviewIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "localeGateReceipt": { "type": "string", "pattern": "^receipt-[a-z0-9-]+$" },
          "closureCriteria": { "type": "string", "minLength": 1 },
          "englishCandidate": {
            "type": "object",
            "required": ["zhReviewHash", "zhRendererFiles", "enAuthoredHash", "enEffectiveHash", "enReviewHash", "enRendererFiles", "englishUpdatedAt", "reviewIds"],
            "properties": {
              "zhReviewHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "zhRendererFiles": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^app/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[A-Za-z0-9_.@()\\[\\]-]+(?:/[A-Za-z0-9_.@()\\[\\]-]+)*\\.(?:tsx?|jsx?|mjs)$" }, "uniqueItems": true },
              "enAuthoredHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "enEffectiveHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "enReviewHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "enRendererFiles": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^app/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[A-Za-z0-9_.@()\\[\\]-]+(?:/[A-Za-z0-9_.@()\\[\\]-]+)*\\.(?:tsx?|jsx?|mjs)$" }, "uniqueItems": true },
              "englishUpdatedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "reviewIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
            },
            "additionalProperties": false
          },
          "closedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "promotedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "closureReviewIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "closureReceipt": { "type": "string", "pattern": "^receipt-[a-z0-9-]+$" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "closed" } }, "required": ["status"] },
            "then": { "required": ["englishCandidate", "closedAt", "promotedCommit", "closureReviewIds", "closureReceipt"] },
            "else": {
              "allOf": [
                { "not": { "required": ["closedAt"] } },
                { "not": { "required": ["promotedCommit"] } },
                { "not": { "required": ["closureReviewIds"] } },
                { "not": { "required": ["closureReceipt"] } }
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
