{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module-polish-progress.schema.json",
  "title": "Module polish tracked progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "planId",
    "batches"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/module-polish-progress.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "note",
          "modules"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^batch-[0-9]{2}-[a-z0-9-]+$"
          },
          "status": {
            "enum": [
              "planned",
              "prepared",
              "in-progress",
              "verified",
              "complete",
              "blocked"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slug",
                "status",
                "note"
              ],
              "properties": {
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "status": {
                  "enum": [
                    "planned",
                    "in-progress",
                    "ready",
                    "verified",
                    "complete",
                    "blocked"
                  ]
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
