{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module-polish-plan.schema.json",
  "title": "Module polish scheduling plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "planId",
    "batches"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/module-polish-plan.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "title",
          "dependsOn",
          "modules"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^batch-[0-9]{2}-[a-z0-9-]+$"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^batch-[0-9]{2}-[a-z0-9-]+$"
            }
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        }
      }
    }
  }
}
